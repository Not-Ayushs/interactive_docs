{
  "manifest_version": 3,
  "name": "Clicky for iDOCS",
  "version": "1.0.0",
  "description": "Capture selected research text and its source into the active iDOCS document.",
  "permissions": ["tabs", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
